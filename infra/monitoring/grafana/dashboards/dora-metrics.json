{
  "title": "DORA Metrics — Golden Paths",
  "uid": "dora-metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "track",
        "label": "Track",
        "default": "mlops",
        "options": [
          { "text": "MLOps", "value": "mlops" },
          { "text": "LLMOps", "value": "llmops" }
        ],
        "current": { "text": "MLOps", "value": "mlops" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Lead Time (p50/p95) — Golden Path",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(golden_path_lead_time_seconds_bucket[1h])) by (le, golden_path))",
          "legendFormat": "p50 {{golden_path}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(golden_path_lead_time_seconds_bucket[1h])) by (le, golden_path))",
          "legendFormat": "p95 {{golden_path}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Deployment Frequency (successful completions / day)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(increase(golden_path_completions_total{status=\"success\"}[1d])) by (golden_path)",
          "legendFormat": "{{golden_path}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Step Duration Breakdown (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(golden_path_step_duration_seconds_bucket[1h])) by (le, golden_path, step))",
          "legendFormat": "{{golden_path}} / {{step}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Completions, success vs failure",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(golden_path_completions_total) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Lead Time samples",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(golden_path_lead_time_seconds_count)" }
      ]
    },
    {
      "id": 6,
      "title": "Pre-activation Gate Failure Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(dora_gate_evaluations_total{track=\"$track\",passed=\"false\"}[1h])) by (subject_type, subject_id) / sum(rate(dora_gate_evaluations_total{track=\"$track\"}[1h])) by (subject_type, subject_id)",
          "legendFormat": "{{subject_type}} {{subject_id}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "MTTR (Incident Recovery, p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(dora_incident_recovery_seconds_bucket{track=\"$track\"}[1d])) by (le, track, subject_type, subject_id))",
          "legendFormat": "{{subject_type}} {{subject_id}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Deployment Frequency (unified)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(increase(dora_deployment_events_total{track=\"$track\",event_type=\"deploy\"}[1d])) by (subject_type, subject_id)",
          "legendFormat": "{{subject_type}} {{subject_id}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "LLM Spend (USD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "dora_llm_spend_usd",
          "legendFormat": "{{model}}"
        }
      ]
    }
  ]
}
