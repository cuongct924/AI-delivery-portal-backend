# Runs `feast serve` for online feature serving on worker2 (ai-platform-zone)
# — the SDK-in-process path (adapters/feature_store_adapter.py's FeastAdapter,
# used for offline features / list_available_features) is untouched and
# keeps reading this same repo baked into orchestration-api's own image; this
# is purely the additive online-serving path fronted over HTTP.
FROM python:3.12-slim
WORKDIR /repo
# Pinned to match adapters/requirements.txt — a client/server Feast version
# mismatch can silently disagree on the on-disk registry format.
RUN pip install --no-cache-dir feast==0.66.0
RUN useradd --create-home --uid 1000 appuser
COPY --chown=appuser:appuser feature_definitions.py feature_store.yaml ./
# data/registry.db + data/online_store.db are gitignored (generated by `feast
# apply`/`materialize`, see .gitignore) — this build only works from a repo
# checkout that already has them; scripts/setup-3node-infra.sh seeds the same
# tree onto the k3d node before building, same pattern as orchestration-api's
# Dockerfile freezing this directory at build time.
COPY --chown=appuser:appuser data/ ./data/
USER appuser
EXPOSE 6566
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import socket; socket.create_connection(('localhost', 6566), timeout=3)" || exit 1
CMD ["feast", "serve", "-h", "0.0.0.0", "-p", "6566"]
