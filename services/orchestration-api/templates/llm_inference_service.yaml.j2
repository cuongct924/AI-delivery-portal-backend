apiVersion: serving.kserve.io/v1beta1
kind: InferenceService
metadata:
  name: {{ model_name }}
  labels:
    version: "{{ model_version }}"
spec:
  predictor:
    {% if canary_traffic_percent is not none %}
    canaryTrafficPercent: {{ canary_traffic_percent }}
    {% endif %}
    model:
      modelFormat:
        name: huggingface
      runtime: {{ serving_runtime_name }}
      storageUri: hf://{{ huggingface_model_id }}
      args:
        - --tensor-parallel-size={{ gpu_count }}
        - --max-model-len={{ max_context_length }}
        {% if vllm_quantization is not none %}
        - --quantization={{ vllm_quantization }}
        {% endif %}
        {% if batching_strategy is not none %}
        - --batching-strategy={{ batching_strategy }}
        {% endif %}
        {% if enable_paged_attention is not none %}
        {% if enable_paged_attention %}
        - --enable-paged-attention
        {% else %}
        - --disable-paged-attention
        {% endif %}
        {% endif %}
        {% if enable_prefix_caching is not none %}
        {% if enable_prefix_caching %}
        - --enable-prefix-caching
        {% else %}
        - --disable-prefix-caching
        {% endif %}
        {% endif %}
        {% if pipeline_parallel_size is not none %}
        - --pipeline-parallel-size={{ pipeline_parallel_size }}
        {% endif %}
      {% if hf_token_secret_ref is not none %}
      env:
        - name: HUGGING_FACE_HUB_TOKEN
          valueFrom:
            secretKeyRef:
              name: {{ hf_token_secret_ref }}
              key: token
      {% endif %}
      resources:
        requests:
          nvidia.com/gpu: "{{ gpu_count }}"
        limits:
          nvidia.com/gpu: "{{ gpu_count }}"
