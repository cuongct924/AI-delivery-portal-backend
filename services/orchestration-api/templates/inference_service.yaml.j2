{#
  Mock/legacy-backend-mode-only rendering (routers/models.py's
  prepare_deploy_manifest, else branch of `if backend_mode == "openchoreo"`).
  Standard model-serving's real backend renders workload.yaml.j2 instead —
  this file exists so mock mode (MockInferenceAdapter, which mimics this raw
  KServe shape) still has a matching PR-gated manifest to render, not
  because any real cluster path deploys from it.
#}
apiVersion: serving.kserve.io/v1beta1
kind: InferenceService
metadata:
  name: {{ model_name }}
  labels:
    version: "{{ model_version }}"
spec:
  predictor:
    {% if canary_traffic_percent is not none %}
    canaryTrafficPercent: {{ canary_traffic_percent }}
    {% endif %}
    model:
      modelFormat:
        name: mlflow
      storageUri: {{ storage_uri }}
