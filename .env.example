# Copy to .env (do not commit the real .env — already in .gitignore)

USE_MOCK_ADAPTERS=false
USE_MOCK_MODEL_REGISTRY=
# Accepts "openchoreo" (adapters/openchoreo_workflow_adapter.py, the real
# default when unset — Golden Paths #1/#3 are cut over) or "mock".
# "legacy" (the removed Argo Server adapter) now raises — see
# docs/openchoreo-workflow-migration-plan.md Phase 6.
USE_MOCK_WORKFLOW=
# Standard model-serving golden path (routers/models.py) only. Accepts
# "openchoreo" (adapters/openchoreo_inference_adapter.py, the real default
# when unset) or "mock". "legacy" (the removed generic KServe-direct
# deploy_model()) now raises — see adapters/kserve_adapter.py, which is
# GPU-serving-only now. Traffic strategy is direct/blue-green(100%)/rollback
# only — no partial split, OpenChoreo's ClusterComponentType has no canary
# slot to render one into.
USE_MOCK_INFERENCE=
# LLM self-hosted-serving golden path (routers/llm_serving.py) only —
# separate from USE_MOCK_INFERENCE above since this one has no "openchoreo"
# mode (no ClusterComponentType for GPU/vLLM serving exists yet). Mock/real
# (adapters/kserve_adapter.py's GpuKServeInferenceAdapter) only.
USE_MOCK_GPU_INFERENCE=
USE_MOCK_NOTEBOOK=
# Mock/real only — no "legacy" backend ever existed for promotion (see
# adapters/openchoreo_promotion_adapter.py's module docstring).
USE_MOCK_PROMOTION=
# Mock/real only — see adapters/huggingface_hub_adapter.py.
USE_MOCK_HUGGINGFACE=
# Mock/real only — see adapters/mlflow_eval_result_adapter.py.
USE_MOCK_EVAL_RESULT=

ANTHROPIC_API_KEY=
# Embedding model for RAG ingest/evaluate (routers/rag.py, routers/chat.py)
# — see infra/ai-platform-zone/litellm-config.yaml's voyage-3 entry.
VOYAGE_API_KEY=
LITELLM_MASTER_KEY=sk-local-dev

# Read by services/orchestration-api (core/config.py) when running outside docker-compose
MLFLOW_TRACKING_URI=http://localhost:5000
KEYCLOAK_URL=http://localhost:8082
LITELLM_GATEWAY_URL=http://localhost:4000
QDRANT_URL=http://localhost:6333
AUTH_ENABLED=false

# Optional — a HuggingFace Hub read token, used only server-side by
# adapters/huggingface_hub_adapter.py to read a gated model's config.json
# for the GPU-sizing estimator (routers/llm_serving.py's
# GET /llm-deploy/validate-model). Never forwarded to a Scaffolder form or
# a rendered manifest — that path always goes through
# PrepareLlmDeployRequest.hf_token_secret_ref (a K8s Secret name) instead.
HUGGINGFACE_HUB_TOKEN=

# Read directly by adapters/openchoreo_workflow_adapter.py
# (USE_MOCK_WORKFLOW=openchoreo). Client credentials default to the
# pre-existing "openchoreo-system-app" (see that adapter's module
# docstring for why — no dedicated client could be registered this
# session).
OPENCHOREO_API_URL=http://api.openchoreo.localhost:8080/api/v1
OPENCHOREO_CLIENT_ID=openchoreo-system-app
OPENCHOREO_CLIENT_SECRET=openchoreo-system-app-secret

# DVC remote (.dvc/config) — dataset versioning, S3-compatible.
# Defaults below match the local `minio` service in docker-compose.yml.
# Swap in real S3 credentials later if needed (only AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY change — DVC reads them like any boto3 client,
# nothing else in .dvc/config needs editing).
DVC_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Local-filesystem dataset source for the Dataset URI picker
# (adapters/local_object_storage_adapter.py) — lists whatever DVC has
# already checked out under data/, merged alongside the MinIO/S3 listing
# above so the picker works even when MinIO isn't running. Leave unset to
# default to this repo's own data/ directory.
LOCAL_DATASETS_PATH=

# Feast offline store (infra/feature-store/feature_definitions.py) — leave
# unset for the local demo parquet. Point at real Object Storage by setting
# FEAST_OFFLINE_STORE_PATH to an s3://<bucket>/... URI and
# FEAST_S3_ENDPOINT_URL to its endpoint; credentials reuse
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above.
FEAST_OFFLINE_STORE_PATH=
FEAST_S3_ENDPOINT_URL=

# LLMOps prompt/RAG-index version registry (adapters/version_registry_adapter.py)
# — leave unset for the default .state/llmops-registry.json relative to
# orchestration-api's cwd.
LLMOPS_REGISTRY_PATH=

# Read by the ArgoCD Backstage plugin (app-config.yaml `argocd.appLocatorMethods`).
# Leave blank until infra/argocd has a real instance —
# the plugin's entity cards just won't load anything until then.
ARGOCD_USERNAME=
ARGOCD_PASSWORD=

# GitHub PAT for the Backstage GitHub integration (app-config.yaml
# `integrations.github.token`) — needed for catalog import and the
# `publish:github:pull-request` Scaffolder action used by Golden Path #2.
GITHUB_TOKEN=
