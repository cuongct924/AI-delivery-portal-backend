# Copy to .env (do not commit the real .env — already in .gitignore)

USE_MOCK_ADAPTERS=false
USE_MOCK_MODEL_REGISTRY=
# Also accepts "openchoreo" (stub — OpenChoreoWorkflowAdapter not implemented yet).
USE_MOCK_WORKFLOW=
# Also accepts "openchoreo" (stub — OpenChoreoInferenceAdapter not implemented yet).
USE_MOCK_INFERENCE=
USE_MOCK_NOTEBOOK=

ANTHROPIC_API_KEY=
# Embedding model for RAG ingest/evaluate (routers/rag.py, routers/chat.py)
# — see infra/llm-gateways/litellm-config.yaml's voyage-3 entry.
VOYAGE_API_KEY=
LITELLM_MASTER_KEY=sk-local-dev

# Read by services/orchestration-api (core/config.py) when running outside docker-compose
MLFLOW_TRACKING_URI=http://localhost:5000
KEYCLOAK_URL=http://localhost:8082
LITELLM_GATEWAY_URL=http://localhost:4000
QDRANT_URL=http://localhost:6333
AUTH_ENABLED=false

# Read directly by adapters/argo_adapter.py. Argo Server runs inside the
# k3d openchoreo-quick-start cluster's workflow plane, exposed on this
# host port by its LoadBalancer service (port mapping not documented in
# this repo yet — see docs/openchoreo-migration-next-steps.md Phase 0).
ARGO_SERVER_URL=http://localhost:10081

# DVC remote (.dvc/config) — dataset versioning, S3-compatible.
# Defaults below match the local `minio` service in docker-compose.yml.
# Swap in real S3 credentials later if needed (only AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY change — DVC reads them like any boto3 client,
# nothing else in .dvc/config needs editing).
DVC_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Local-filesystem dataset source for the Dataset URI picker
# (adapters/local_object_storage_adapter.py) — lists whatever DVC has
# already checked out under data/, merged alongside the MinIO/S3 listing
# above so the picker works even when MinIO isn't running. Leave unset to
# default to this repo's own data/ directory.
LOCAL_DATASETS_PATH=

# Feast offline store (infra/feature-store/feature_definitions.py) — leave
# unset for the local demo parquet. Point at real Object Storage by setting
# FEAST_OFFLINE_STORE_PATH to an s3://<bucket>/... URI and
# FEAST_S3_ENDPOINT_URL to its endpoint; credentials reuse
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above.
FEAST_OFFLINE_STORE_PATH=
FEAST_S3_ENDPOINT_URL=

# LLMOps prompt/RAG-index version registry (adapters/version_registry_adapter.py)
# — leave unset for the default .state/llmops-registry.json relative to
# orchestration-api's cwd.
LLMOPS_REGISTRY_PATH=

# Read by the ArgoCD Backstage plugin (app-config.yaml `argocd.appLocatorMethods`).
# Leave blank until infra/argocd has a real instance —
# the plugin's entity cards just won't load anything until then.
ARGOCD_USERNAME=
ARGOCD_PASSWORD=

# GitHub PAT for the Backstage GitHub integration (app-config.yaml
# `integrations.github.token`) — needed for catalog import and the
# `publish:github:pull-request` Scaffolder action used by Golden Path #2.
GITHUB_TOKEN=
